	})

	local swatches = {
		{ "Purple", Color3.fromRGB(125, 85, 255) },
		{ "Blue", Color3.fromRGB(70, 130, 255) },
		{ "Cyan", Color3.fromRGB(0, 200, 220) },
		{ "Green", Color3.fromRGB(70, 200, 90) },
		{ "Yellow", Color3.fromRGB(240, 200, 50) },
		{ "Orange", Color3.fromRGB(255, 140, 40) },
		{ "Red", Color3.fromRGB(230, 60, 60) },
		{ "Pink", Color3.fromRGB(255, 95, 170) },
		{ "White", Color3.fromRGB(255, 255, 255) },
	}

	local marked
	local function setMark(btn)
		if marked then
			local st = marked:FindFirstChildOfClass("UIStroke")
			st.Color = COL.stroke
			st.Thickness = 1
		end
		marked = btn
		if btn then
			local st = btn:FindFirstChildOfClass("UIStroke")
			st.Color = Color3.fromRGB(255, 255, 255)
			st.Thickness = 2
		end
	end

	local hexBox
	for i, s in ipairs(swatches) do
		local btn = new("TextButton", {
			Name = s[1],
