-- VISUALS PAGE: ESP / TRACERS / HEALTH
---------------------------------------------------------------------
do
	local page = makePage("Visuals")
	local sf = scrollPage(page)
	local o = 0
	local function nxt() o += 1 return o end

	local cfg = {
		esp = false,
		tracers = false,
		names = true,
		health = true,
		distance = true,
		teamCheck = false,
		maxDist = 2000,
		color = Color3.fromRGB(255, 60, 60),
	}

	local WHITE = Color3.fromRGB(255, 255, 255)
	local GREEN = Color3.fromRGB(70, 200, 90)
	local RED = Color3.fromRGB(220, 60, 60)

	local espFolder = new("Folder", { Name = "SteamESP", Parent = playerGui })
	local entries = {}

	local function destroyEntry(p)
		local e = entries[p]
		if not e then return end
		e.hl:Destroy()
		e.bb:Destroy()
		e.line:Destroy()
		entries[p] = nil
	end

	local function buildEntry(p, char, head)
		local hl = new("Highlight", {
			Name = "SteamESP",
			FillColor = cfg.color,
			OutlineColor = WHITE,
			FillTransparency = 0.6,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			Enabled = false,
			Parent = char,
		})
		local bb = new("BillboardGui", {
			Name = p.Name,
			Adornee = head,
			Size = UDim2.fromOffset(150, 48),
			StudsOffset = Vector3.new(0, 3, 0),
			AlwaysOnTop = true,
			LightInfluence = 0,
			ResetOnSpawn = false,
			Enabled = false,
			Parent = espFolder,
		})
		local nameL = label({
			Size = UDim2.new(1, 0, 0, 16),
			Text = p.DisplayName,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = WHITE,
			TextStrokeTransparency = 0.3,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = bb,
		})
		local bar = new("Frame", {
			Position = UDim2.fromOffset(25, 20),
			Size = UDim2.new(1, -50, 0, 6),
			BackgroundColor3 = Color3.fromRGB(25, 25, 25),
			BorderSizePixel = 0,
			Parent = bb,
		}, { corner(3), stroke(Color3.fromRGB(0, 0, 0), 1) })
		local fill = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = GREEN,
			BorderSizePixel = 0,
			Parent = bar,
		}, { corner(3) })
		local info = label({
			Position = UDim2.fromOffset(0, 29),
			Size = UDim2.new(1, 0, 0, 16),
			Text = "",
			TextSize = 12,
			TextColor3 = WHITE,
			TextStrokeTransparency = 0.4,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = bb,
		})
		local line = new("Frame", {
			Name = p.Name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = cfg.color,
			BorderSizePixel = 0,
			Visible = false,
			Parent = overlay,
		})
		return { char = char, hl = hl, bb = bb, name = nameL, bar = bar, fill = fill, info = info, line = line }
	end

	RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local myRoot = getRoot()
		local vp = cam.ViewportSize
		local any = cfg.esp or cfg.tracers

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local ok = any and hum ~= nil and root ~= nil and hum.Health > 0

				local dist = 0
				if ok and myRoot then
					dist = (root.Position - myRoot.Position).Magnitude
					if dist > cfg.maxDist then ok = false end
				end
				if ok and cfg.teamCheck and p.Team ~= nil and p.Team == player.Team then
					ok = false
				end

				local e = entries[p]
				if ok then
					if not e or e.char ~= char then
						destroyEntry(p)
						e = buildEntry(p, char, char:FindFirstChild("Head") or root)
						entries[p] = e
					end

					e.hl.Enabled = cfg.esp
					e.hl.FillColor = cfg.color
					e.bb.Enabled = cfg.esp
					if cfg.esp then
						e.name.Visible = cfg.names
						e.bar.Visible = cfg.health
						e.info.Visible = cfg.health or cfg.distance
						local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						e.fill.Size = UDim2.fromScale(frac, 1)
						e.fill.BackgroundColor3 = RED:Lerp(GREEN, frac)
						local parts = {}
						if cfg.health then
							table.insert(parts, math.floor(hum.Health + 0.5) .. "/" .. math.floor(hum.MaxHealth + 0.5) .. " HP")
						end
						if cfg.distance then
							table.insert(parts, math.floor(dist + 0.5) .. " studs")
						end
						e.info.Text = table.concat(parts, "  |  ")
					end

					if cfg.tracers then
						local pos, onScreen = cam:WorldToViewportPoint(root.Position)
						if onScreen then
							local from = Vector2.new(vp.X / 2, vp.Y)
							local to = Vector2.new(pos.X, pos.Y)
							local d = to - from
							e.line.Size = UDim2.fromOffset(d.Magnitude, 2)
							e.line.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
							e.line.Rotation = math.deg(math.atan2(d.Y, d.X))
							e.line.BackgroundColor3 = cfg.color
							e.line.Visible = true
						else
							e.line.Visible = false
						end
					else
						e.line.Visible = false
					end
				elseif e then
					e.hl.Enabled = false
					e.bb.Enabled = false
					e.line.Visible = false
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(destroyEntry)

	-- UI ----------------------------------------------------------
	sectionLabel(sf, nxt(), "ESP")
	toggleRow(sf, nxt(), "ESP", "Highlights players through walls", function(v) cfg.esp = v end)
	toggleRow(sf, nxt(), "ESP Tracers", "Line from the bottom of the screen to each player", function(v) cfg.tracers = v end)

	sectionLabel(sf, nxt(), "ESP INFO")
	local _, setHealth = toggleRow(sf, nxt(), "Show Health", "Health bar and HP number above players", function(v) cfg.health = v end)
	local _, setNames = toggleRow(sf, nxt(), "Show Names", "Display names above players", function(v) cfg.names = v end)
	local _, setDist = toggleRow(sf, nxt(), "Show Distance", "Distance to each player in studs", function(v) cfg.distance = v end)
	setHealth(true)
	setNames(true)
	setDist(true)

	sectionLabel(sf, nxt(), "OPTIONS")
	toggleRow(sf, nxt(), "Team Check", "Ignore players on your team", function(v) cfg.teamCheck = v end)
	inputRow(sf, nxt(), "Max distance", cfg.maxDist, function(box)
		local n = tonumber(box.Text)
		if n then cfg.maxDist = math.clamp(n, 10, 100000) end
		box.Text = tostring(cfg.maxDist)
	end)
	inputRow(sf, nxt(), "ESP color (hex)", "#" .. cfg.color:ToHex():upper(), function(box)
		local txt = box.Text
		if not txt:find("^#") then txt = "#" .. txt end
		local ok, c = pcall(Color3.fromHex, txt)
		if ok and c then cfg.color = c end
		box.Text = "#" .. cfg.color:ToHex():upper()
	end)
end

