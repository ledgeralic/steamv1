local function trySubmit()
	if unlocked then return end
	local entered = keyBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if entered == KEY then
		unlocked = true
		keyStatus.Text = "Key accepted!"
		keyStatus.TextColor3 = COL.green
		task.delay(0.6, function()
			keyWindow.Visible = false
			setOpen(true)
		end)
	else
		keyStatus.Text = "Invalid key"
		keyStatus.TextColor3 = COL.red
		keyBox.Text = ""
	end
end
submitBtn.MouseButton1Click:Connect(trySubmit)
keyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then trySubmit() end
end)

local function toggleClick()
	if unlocked then
		setOpen(not menu.Visible)
	else
		keyWindow.Visible = not keyWindow.Visible
	end
end

do
	local isDown, moved, startInput, startPos = false, false, nil, nil
	toggle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDown, moved = true, false
			startInput = input.Position
			startPos = toggle.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not isDown then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local d = input.Position - startInput
			if not moved and d.Magnitude > 5 then moved = true end
			if moved then
				local abs = gui.AbsoluteSize
				local x = math.clamp(startPos.X.Offset + d.X, 0, abs.X - 56)
				local y = math.clamp(startPos.Y.Offset + d.Y, -(abs.Y - 56), 0)
				toggle.Position = UDim2.new(0, x, 1, y)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isDown and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			isDown = false
			if not moved then toggleClick() end
		end
	end)
end

