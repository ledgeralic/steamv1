-- MAIN PAGE: AIMBOT
---------------------------------------------------------------------
do
	local page = makePage("Main")
	local sf = scrollPage(page)
	local o = 0
	local function nxt() o += 1 return o end

	local cfg = {
		enabled = false,
		always = false,
		showFov = true,
		fov = 150,
		smooth = 8,
		head = true,
		teamCheck = false,
		visCheck = true,
	}

	local fovCircle = new("Frame", {
		Name = "AimbotFOV",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(cfg.fov * 2, cfg.fov * 2),
		Visible = false,
		Parent = overlay,
	}, {
		new("UICorner", { CornerRadius = UDim.new(1, 0) }),
		new("UIStroke", { Color = Color3.fromRGB(255, 255, 255), Thickness = 1.5, Transparency = 0.3 }),
	})

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local function getTarget(cam, mousePos)
		local best, bestDist = nil, cfg.fov
		rayParams.FilterDescendantsInstances = { player.Character }
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local part = char and ((cfg.head and char:FindFirstChild("Head")) or char:FindFirstChild("HumanoidRootPart"))
				if part and hum and hum.Health > 0 and not (cfg.teamCheck and p.Team ~= nil and p.Team == player.Team) then
					local sp, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen then
						local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
						if d < bestDist then
							local clear = true
							if cfg.visCheck then
								local origin = cam.CFrame.Position
								local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
								clear = (hit == nil) or hit.Instance:IsDescendantOf(char)
							end
							if clear then best, bestDist = part, d end
						end
					end
				end
			end
		end
		return best
	end

	RunService:BindToRenderStep("SteamAimbot", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = workspace.CurrentCamera
		local mousePos = UserInputService:GetMouseLocation()

		fovCircle.Visible = cfg.enabled and cfg.showFov
		fovCircle.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
		fovCircle.Size = UDim2.fromOffset(cfg.fov * 2, cfg.fov * 2)

		if not cfg.enabled or not cam then return end
		if UserInputService:GetFocusedTextBox() then return end
		local active = cfg.always or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		if not active then return end

		local target = getTarget(cam, mousePos)
		if target then
			local alpha = 1 - (1 - 1 / math.max(cfg.smooth, 1)) ^ (dt * 60)
			cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, target.Position), alpha)
		end
	end)

	-- UI ----------------------------------------------------------
	sectionLabel(sf, nxt(), "AIMBOT")
	toggleRow(sf, nxt(), "Aimbot", "Hold right mouse button to lock onto a player", function(v) cfg.enabled = v end)
	toggleRow(sf, nxt(), "Always Aim", "Aim without holding a button (good for mobile)", function(v) cfg.always = v end)

	sectionLabel(sf, nxt(), "TUNING")
	sliderRow(sf, nxt(), "Aimbot FOV (pixels)", 20, 600, cfg.fov, function(v) cfg.fov = v end)
	sliderRow(sf, nxt(), "Smoothness (1 = instant, higher = slower)", 1, 50, cfg.smooth, function(v) cfg.smooth = v end)
	local _, setFov = toggleRow(sf, nxt(), "Show FOV Circle", "Draws the aim radius around your cursor", function(v) cfg.showFov = v end)
	setFov(true)

	sectionLabel(sf, nxt(), "TARGETING")
	local _, setHead = toggleRow(sf, nxt(), "Aim at Head", "Off = aim at the torso", function(v) cfg.head = v end)
	local _, setVis = toggleRow(sf, nxt(), "Visible Check", "Skip players hidden behind walls", function(v) cfg.visCheck = v end)
	setHead(true)
	setVis(true)
	toggleRow(sf, nxt(), "Team Check", "Ignore players on your team", function(v) cfg.teamCheck = v end)
end

