	local valL = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Size = UDim2.fromOffset(80, 18),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 13,
		TextColor3 = COL.dim,
		Parent = row,
	})
	local track = new("TextButton", {
		Position = UDim2.fromOffset(12, 34),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = COL.panel2,
		Text = "",
		AutoButtonColor = false,
		Parent = row,
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = COL.accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = COL.text,
		Parent = track,
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })

	local function apply(v)
		v = math.clamp(v, min, max)
		local frac = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(frac, 1)
		knob.Position = UDim2.fromScale(frac, 0.5)
		valL.Text = tostring(v)
		onChange(v)
	end
	local function setFromX(x)
		local frac = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		apply(math.floor(min + frac * (max - min) + 0.5))
	end

	local dragging = false
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
		end
	end)
	apply(default)
	return row
end

