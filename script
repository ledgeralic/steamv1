do
	local page = makePage("Settings")
	local sf = scrollPage(page)
	local o = 0
	local function nxt() o += 1 return o end

	local function skip(d)
		return d:GetAttribute("NoRecolor") or (d.Parent and d.Parent:GetAttribute("NoRecolor"))
	end

	local function applyAccent(newColor)
		local old = COL.accent
		if old == newColor then return end
		COL.accent = newColor
		local roots = { menu, toggle }
		for _, r in ipairs(roots) do
			for _, d in ipairs(r:GetDescendants()) do
				if not skip(d) then
					if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.TextColor3 == old then
						d.TextColor3 = newColor
					end
					if d:IsA("GuiObject") and d.BackgroundColor3 == old then
						d.BackgroundColor3 = newColor
					end
					if d:IsA("UIStroke") and d.Color == old then
						d.Color = newColor
					end
				end
			end
		end
	end

	sectionLabel(sf, nxt(), "ACCENT COLOR")

	local swatchBox = new("Frame", {
		Size = UDim2.new(1, -8, 0, 60),
		BackgroundColor3 = COL.bg,
		LayoutOrder = nxt(),
